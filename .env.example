# ============================================
# GOOGLE OAUTH & GMAIL CONFIGURATION
# ============================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE

# Email to receive contact form submissions (CRITICAL: Use environment variable, not hardcoded)
CONTACT_EMAIL=hola@frecdigital.com

# ============================================
# N8N WEBHOOK CONFIGURATION
# ============================================
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/chat

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hola@frecdigital.com

# ============================================
# SEO & ANALYTICS CONFIGURATION
# ============================================
# Google Analytics (obtén el ID desde Google Analytics)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Search Console Verification (obtén de Google Search Console)
GOOGLE_SITE_VERIFICATION=your_verification_code

# Yandex Verification (opcional, para mercados rusos)
# YANDEX_VERIFICATION=your_yandex_verification_code

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Rate limiting (requests per time window)
# Contact form: 5 requests per hour
# OAuth: 10 requests per 15 minutes
# Gmail: 20 requests per hour
# These are handled automatically, but you can override in code if needed

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://frecdigital.com,https://www.frecdigital.com

# Optional: Email Configuration (for future use with alternative providers)
# RESEND_API_KEY=your_resend_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key
