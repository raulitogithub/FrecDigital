# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Gmail Configuration
GOOGLE_REFRESH_TOKEN=YOUR_REFRESH_TOKEN_HERE
GMAIL_USER=your-email@gmail.com

# N8N Webhook Configuration
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/chat

# Email Configuration (Optional - for form submission)
# Choose one of the options below:

# Option 1: Resend (https://resend.com)
# RESEND_API_KEY=your_resend_api_key

# Option 2: EmailJS (https://www.emailjs.com)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Your custom email to receive form submissions
NEXT_PUBLIC_CONTACT_EMAIL=hola@frecdigital.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
